{
  "name": "m6-a5000-http-profile-c64",
  "description": "HTTP serving profile at c=64 (closed-fixed 256/128, --cuda-graphs), run with PYTHONPATH=benchmarks/scripts/profiling and DLI_PROF_OUT=<dir> (see the hook docstring). The engine-process profile (...-m6-http-profile-proc/) ran this plan with --engine process; the threaded profile (...-m6-http-profile/) predates the --engine flag (threaded engine).",
  "label": "GPU-A5000x1-runpod",
  "device": "cuda",
  "dtype": "bfloat16",
  "reps": 1,
  "port": 8300,
  "max_num_seqs": 128,
  "max_num_batched_tokens": 2048,
  "saturation_ttft_s": 10.0,
  "request_timeout_s": 900,
  "backends": {
    "dli-graphs": {
      "kind": "dli",
      "block_size": 16,
      "extra_args": [
        "--cuda-graphs",
        "--engine",
        "process"
      ]
    }
  },
  "models": [
    {
      "name": "qwen2.5-0.5b",
      "repo": "Qwen/Qwen2.5-0.5B-Instruct",
      "backends": [
        "dli-graphs"
      ],
      "experiments": [
        "closed-fixed"
      ],
      "overrides": {
        "dli-graphs": {
          "num_blocks": 100416
        }
      }
    }
  ],
  "experiments": {
    "closed-fixed": {
      "workload": {
        "type": "synthetic",
        "input": {
          "fixed": 256
        },
        "output": {
          "fixed": 128
        }
      },
      "mode": "closed",
      "points": [
        64
      ],
      "n_per_concurrency": 4,
      "backends": [
        "dli-graphs"
      ]
    }
  }
}
