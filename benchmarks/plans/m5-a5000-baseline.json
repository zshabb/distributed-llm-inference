{
  "name": "m5-a5000-baseline",
  "description": "Focused M6 baseline on the RunPod RTX A5000 (owner-approved 2026-11-11): the M5 measurements M6 is expected to change, on the GPU M6 will be measured on. Not a repeat of the full M5 campaign (no shared-prefix, multi-turn, AC5, precision or AWQ runs; those results stand on the A16). Native KV pools = vLLM capacity / 16 measured in the A5000 pilot (attempt 2). vLLM: VLLM_USE_FLASHINFER_SAMPLER=0 (the A16 sampler; see benchmarks/baselines/vllm/README.md). Pilot capacities: 1,606,656 / 604,496 / 88,848 tokens.",
  "label": "GPU-A5000x1-runpod",
  "device": "cuda",
  "dtype": "bfloat16",
  "reps": 3,
  "port": 8300,
  "max_num_seqs": 128,
  "max_num_batched_tokens": 2048,
  "saturation_ttft_s": 10.0,
  "request_timeout_s": 900,
  "backends": {
    "dli": {
      "kind": "dli",
      "block_size": 16,
      "extra_args": [
        "--engine",
        "thread"
      ]
    },
    "vllm": {
      "kind": "vllm",
      "gpu_memory_utilization": 0.85,
      "max_model_len": 4096,
      "extra_args": [
        "--enable-prefix-caching"
      ],
      "env": {
        "VLLM_USE_FLASHINFER_SAMPLER": "0"
      }
    },
    "hf": {
      "kind": "hf",
      "max_batch": 16,
      "max_wait_ms": 20
    }
  },
  "models": [
    {
      "name": "qwen2.5-0.5b",
      "repo": "Qwen/Qwen2.5-0.5B-Instruct",
      "backends": [
        "dli",
        "vllm",
        "hf"
      ],
      "experiments": [
        "closed-fixed",
        "open-lognormal"
      ],
      "overrides": {
        "dli": {
          "num_blocks": 100416
        }
      }
    },
    {
      "name": "qwen2.5-1.5b",
      "repo": "Qwen/Qwen2.5-1.5B-Instruct",
      "backends": [
        "dli",
        "vllm",
        "hf"
      ],
      "experiments": [
        "closed-fixed-large"
      ],
      "overrides": {
        "dli": {
          "num_blocks": 37781
        }
      }
    },
    {
      "name": "smollm2-1.7b",
      "repo": "HuggingFaceTB/SmolLM2-1.7B-Instruct",
      "backends": [
        "dli",
        "vllm"
      ],
      "experiments": [
        "closed-fixed-large"
      ],
      "overrides": {
        "dli": {
          "num_blocks": 5553
        }
      }
    }
  ],
  "experiments": {
    "closed-fixed": {
      "description": "Max throughput at concurrency 1/16/64; input 256, output 128. AC3 is the c=16 point.",
      "workload": {
        "type": "synthetic",
        "input": {
          "fixed": 256
        },
        "output": {
          "fixed": 128
        }
      },
      "mode": "closed",
      "points": [
        1,
        16,
        64
      ],
      "n_per_concurrency": 2,
      "n_extra": 8,
      "backends": [
        "dli",
        "vllm",
        "hf"
      ]
    },
    "closed-fixed-large": {
      "workload": {
        "type": "synthetic",
        "input": {
          "fixed": 256
        },
        "output": {
          "fixed": 128
        }
      },
      "mode": "closed",
      "points": [
        16,
        64
      ],
      "n_per_concurrency": 2
    },
    "open-lognormal": {
      "description": "Latency vs offered load; input median 512 (sigma 0.8, 32-2048), output median 128 (sigma 0.8, 16-512).",
      "workload": {
        "type": "synthetic",
        "input": {
          "median": 512,
          "sigma": 0.8,
          "lo": 32,
          "hi": 2048
        },
        "output": {
          "median": 128,
          "sigma": 0.8,
          "lo": 16,
          "hi": 512
        }
      },
      "mode": "open",
      "points": [
        0.5,
        1,
        2,
        4,
        8,
        16,
        32,
        64
      ],
      "duration_s": 40,
      "min_n": 30,
      "max_n": 500,
      "drain_s": 120,
      "backends": [
        "dli",
        "vllm"
      ]
    }
  }
}