{
 "name": "m5-gpu",
 "description": "M5 A16 campaign (AC3 GPU, AC4, AC5): native engine vs vLLM v0.32.0 vs HF static batching, bf16. KV pools: native num_blocks = vLLM's reported KV capacity / 16 at --gpu-memory-utilization 0.85 (pilot 2026-11-11: 946,960 / 321,248 / 47,440 tokens). Rate grids from the pilot's closed-loop throughput.",
 "label": "GPU-A16x1-vultr",
 "device": "cuda",
 "dtype": "bfloat16",
 "reps": 3,
 "port": 8300,
 "max_num_seqs": 128,
 "max_num_batched_tokens": 2048,
 "saturation_ttft_s": 10.0,
 "request_timeout_s": 900,
 "backends": {
  "dli": {
   "kind": "dli",
   "block_size": 16
  },
  "dli-noprefix": {
   "kind": "dli",
   "block_size": 16,
   "extra_args": [
    "--no-prefix-caching"
   ]
  },
  "vllm": {
   "kind": "vllm",
   "gpu_memory_utilization": 0.85,
   "max_model_len": 4096,
   "extra_args": [
    "--enable-prefix-caching"
   ]
  },
  "hf": {
   "kind": "hf",
   "max_batch": 16,
   "max_wait_ms": 20
  }
 },
