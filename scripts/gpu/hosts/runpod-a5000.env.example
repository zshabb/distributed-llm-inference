# Host profile: RunPod pod with one RTX A5000 (no Docker daemon; network volume at /workspace).
# Copy to runpod-a5000.env (untracked). Select with GPU_PROFILE=runpod-a5000. Never put secrets here.
#
# Reach the pod through an ssh_config alias (address, port, key, pinned host key live in
# ~/.ssh/config and ~/.ssh/known_hosts_runpod, outside the repository); see docs/operations.md.
GPU_HOST=runpod-a5000
GPU_SSH_PUBKEY=
# Repo and Python environments on fast local container disk (wiped on pod restart, rebuilt by
# bootstrap); results, logs and model caches on the persistent network volume.
GPU_REMOTE_DIR=work/distributed-llm-inference
GPU_RESULTS_DIR=/workspace/dli/results
GPU_LABEL=GPU:A5000x1@runpod
GPU_RESULT_LABEL=GPU-A5000x1-runpod
GPU_HOURLY_USD=0.28                        # compute 0.27 + container disk 0.007 (volume billed separately)
# OMP/MKL thread caps default to the container's real CPU quota (scripts/gpu/cpu_threads.sh).
GPU_REMOTE_ENV='export DLI_PERSIST_DIR=/workspace/dli HF_HOME=/workspace/dli/hf DLI_VLLM_PYTHON=$HOME/vllm-venv/bin/python;'
