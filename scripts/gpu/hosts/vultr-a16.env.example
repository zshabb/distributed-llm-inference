# Host profile: Vultr VM with one A16 GPU (Docker available). Copy to vultr-a16.env (untracked).
# Select with GPU_PROFILE=vultr-a16. Never put secrets here.
GPU_HOST=root@203.0.113.10                 # or an ssh_config alias
GPU_SSH_PUBKEY=$HOME/.ssh/vultr_gpu.pub    # public key of the agent identity (or empty with an alias)
GPU_REMOTE_DIR=work/distributed-llm-inference
GPU_LABEL=GPU:A16x1@vultr
GPU_RESULT_LABEL=GPU-A16x1-vultr
GPU_HOURLY_USD=0.471
GPU_REMOTE_ENV=''
