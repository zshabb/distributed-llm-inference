# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Secrets and local machine config (never committed)
.env
*.pem
*.key
scripts/gpu/host.env

# Model weights and large artifacts are downloaded, never committed
models/
*.safetensors
*.bin
*.gguf

# Raw benchmark scratch output (summaries and small raw data under benchmarks/results/ ARE committed)
benchmarks/results/**/scratch/

# Host security posture (sshd/firewall/listening sockets) stays local: never in a public repository.
benchmarks/results/**/inspect.txt

# API key records (Argon2 hashes) for dli-serve
keys.json
*.keys.json
